---
import EpisodeList from '../components/EpisodeList.jsx';
import { getCollection } from 'astro:content';
import '../styles/global.css';
import fs from 'node:fs';
import path from 'node:path';

const episodes = await getCollection('episodes');

const orderFile = path.join(process.cwd(), 'src/data/order.json');
const order: string[] = fs.existsSync(orderFile)
  ? JSON.parse(fs.readFileSync(orderFile, 'utf-8'))
  : [];

const staticEpisodes = episodes
  .map(e => ({ id: e.id, title: e.data.title, subtitle: e.data.subtitle ?? '' }))
  .sort((a, b) => {
    const ia = order.indexOf(a.id);
    const ib = order.indexOf(b.id);
    if (ia === -1 && ib === -1) return 0;
    if (ia === -1) return 1;
    if (ib === -1) return -1;
    return ia - ib;
  });
---
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Event Storming by Example</title>
  </head>
  <body class="bg-gray-50 min-h-screen p-8 flex flex-col">
    <div class="flex-1">
      <h1 class="text-3xl font-bold mb-2">Event Storming by Example</h1>
      <p class="text-gray-500 mb-8">Okreść cel warsztatu, zbierz drużynę, rozmawiaj i modeluj</p>
      <EpisodeList initialEpisodes={staticEpisodes} client:load />
    </div>
    <footer class="mt-16 text-center text-sm text-gray-400">
      <span id="year"></span> | drojewski@gmail.com
    </footer>
    <script>document.getElementById('year').textContent = String(new Date().getFullYear());</script>
  </body>
</html>